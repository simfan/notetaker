    private HashSet<string> _highlightedNoteIds = new();
    private string? _toastMessage;
    private bool _showToast;
    private System.Threading.Timer? _toastTimer;
    private System.Threading.Timer? _highlightTimer;
    private CancellationTokenSource _pollingCts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _ = StartPollingAsync();
    }

    private async Task LoadData()
    {
        loading = true;
        notes = await Svc.GetNotesAsync();
        groups = await Svc.GetGroupsAsync();
        tags = await Svc.GetTagsAsync();
        projects = await Svc.GetProjectsAsync();
        ApplyFilters();
        loading = false;

        if (selectedNote != null)
            selectedNote = notes.FirstOrDefault(n => n.Id == selectedNote.Id);
    }

    private async Task StartPollingAsync()
    {
        while (!_pollingCts.IsCancellationRequested)
        {
            await Task.Delay(30000, _pollingCts.Token).ContinueWith(_ => Task.CompletedTask);
            if (_pollingCts.IsCancellationRequested) break;

            var fresh = await Svc.GetNotesAsync();
            var newNotes = fresh.Where(f => notes.All(n => n.Id != f.Id)).ToList();

            foreach (var note in newNotes)
            {
                notes.Insert(0, note);
                _highlightedNoteIds.Add(note.Id);
                ShowToast($"New note arrived: \"{note.Title}\"");
                _ = Task.Delay(4000).ContinueWith(_ =>
                {
                    _highlightedNoteIds.Remove(note.Id);
                    InvokeAsync(StateHasChanged);
                });
            }

            foreach (var fresh_note in fresh)
            {
                var idx = notes.FindIndex(n => n.Id == fresh_note.Id);
                if (idx >= 0) notes[idx] = fresh_note;
            }

            notes.RemoveAll(n => fresh.All(f => f.Id != n.Id));

            if (newNotes.Any())
                ApplyFilters();

            await InvokeAsync(StateHasChanged);
        }
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        _showToast = true;
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ =>
        {
            _showToast = false;
            InvokeAsync(StateHasChanged);
        }, null, 3500, System.Threading.Timeout.Infinite);
    }

    private void ApplyFilters()
    {
        var query = notes.AsEnumerable();

        if (!string.IsNullOrEmpty(SelectedGroupId))
            query = query.Where(n => n.GroupId == SelectedGroupId);

        if (!string.IsNullOrEmpty(SelectedTagId))
            query = query.Where(n => n.Tags.Any(t => t.Id == SelectedTagId));

        if (!string.IsNullOrEmpty(SelectedProjectId))
        {
            var proj = projects.FirstOrDefault(p => p.Id == SelectedProjectId);
            if (proj?.TagId != null)
                query = query.Where(n => n.Tags.Any(t => t.Id == proj.TagId));
        }

        if (!string.IsNullOrEmpty(_searchQuery))
            query = query.Where(n =>
                n.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                (n.Body?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

        filteredNotes = query.ToList();
    }

    private void SelectGroup(string? id)
