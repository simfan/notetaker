    private async Task ExportNote(Note note)
    {
        var export = new
        {
            id = note.Id,
            title = note.Title,
            body = note.Body,
            tags = note.Tags.Select(t => t.Name).ToList(),
            group = note.Group?.Name,
            metadata = note.Metadata,
            photo_url = note.PhotoUrl,
            created_at = note.CreatedAt,
            updated_at = note.UpdatedAt
        };

        var json = JsonSerializer.Serialize(export, new JsonSerializerOptions { WriteIndented = true });
        var filename = string.Concat(note.Title
            .ToLower()
            .Replace(" ", "-")
            .Where(c => char.IsLetterOrDigit(c) || c == '-')) + ".json";

        await JS.InvokeVoidAsync("downloadFile", filename, json);
    }

    private async Task ExportAllNotes(Project project)
    {
        var export = new
        {
            project = project.Name,
            exported_at = DateTime.UtcNow,
            notes = filteredNotes.Select(note => new
            {
                id = note.Id,
                title = note.Title,
                body = note.Body,
                tags = note.Tags.Select(t => t.Name).ToList(),
                group = note.Group?.Name,
                metadata = note.Metadata,
                photo_url = note.PhotoUrl,
                created_at = note.CreatedAt,
                updated_at = note.UpdatedAt
            }).ToList()
        };

        var json = JsonSerializer.Serialize(export, new JsonSerializerOptions { WriteIndented = true });
        var filename = string.Concat(project.Name
            .ToLower()
            .Replace(" ", "-")
            .Where(c => char.IsLetterOrDigit(c) || c == '-')) + "-export.json";

        await JS.InvokeVoidAsync("downloadFile", filename, json);
    }

