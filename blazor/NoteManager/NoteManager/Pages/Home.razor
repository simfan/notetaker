    private async Task UpdateMetadataField(MetaField field, string? value)
    {
        if (selectedNote == null) return;
        switch (field)
        {
            case MetaField.Url:      selectedNote.Metadata.Url = value; break;
            case MetaField.Language: selectedNote.Metadata.Language = value; break;
            case MetaField.Status:   selectedNote.Metadata.Status = value; break;
            case MetaField.DueDate:  selectedNote.Metadata.DueDate = value; break;
        }
        //selectedNote.InvalidateMetadataCache();
        await Svc.UpdateNoteMetadataAsync(selectedNote.Id, selectedNote.Metadata);
        await LoadData();
    }

    // Shared due date fragment for task/assignment cards
    private RenderFragment NoteTypeDueDateFragment(Note note) => __builder =>
    {
        if (note.NoteType == NoteType.Assignment && !string.IsNullOrEmpty(note.Metadata.DueDate))
        {
            var due = DateTime.TryParse(note.Metadata.DueDate, out var d) ? d : (DateTime?)null;
            var overdue = due.HasValue && due.Value.Date < DateTime.Today && note.Metadata.IsComplete != true;
            __builder.OpenElement(0, "div");
            __builder.AddAttribute(1, "class", $"task-due{(overdue ? " task-due--overdue" : "")}");
            __builder.AddContent(2, $"📅 {(due.HasValue ? due.Value.ToString("MMM d, yyyy") : note.Metadata.DueDate)}");
            if (overdue)
            {
                __builder.OpenElement(3, "span");
                __builder.AddAttribute(4, "class", "overdue-badge");
                __builder.AddContent(5, "Overdue");
                __builder.CloseElement();
            }
            __builder.CloseElement();
        }
    };

