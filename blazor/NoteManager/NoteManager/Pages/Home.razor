@page "/"
@inject SupabaseService Svc
@inject IJSRuntime JS
@*inject JiraService JiraSvc*@
@using System.Text.Json

<PageTitle>NoteKeeper — Desktop</PageTitle>

<div class="app-shell">
    @if (_showToast)
    {
        <div class="realtime-toast">
            <span>📡 @_toastMessage</span>
        </div>
    }
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <span class="brand-icon">📋</span>
            <span class="brand-name">NoteKeeper</span>
        </div>

        <!-- Groups Nav -->
        <div class="nav-section">
            <div class="nav-section-label">Groups</div>
            <a class="nav-item @(SelectedGroupId == null && SelectedTagId == null && SelectedProjectId == null ? "active" : "")" @onclick='() => SelectGroup(null)'>
                <span class="nav-icon">🗂️</span> All Notes
                <span class="nav-badge">@notes.Count</span>
            </a>
            @foreach (var g in groups)
            {
                <a class="nav-item @(SelectedGroupId == g.Id ? "active" : "")"
                   @onclick="() => SelectGroup(g.Id)">
                    <span class="group-dot" style="background:@g.Color"></span>
                    @g.Name
                    <button class="share-toggle @(g.IsPublic ? "share-on" : "share-off")"
                            title="@(g.IsPublic ? "Public — click to make private" : "Private — click to make public")"
                            @onclick="() => ToggleGroupPublic(g)"
                            @onclick:stopPropagation="true">
                        @(g.IsPublic ? "🌐" : "🔒")
                    </button>
                </a>
                @if (g.IsPublic == true)
                {
                    var endpointUrl = $"{Svc.PublicEndpointBase}";
                    var curlExample = $"curl -X POST \"{endpointUrl}\" \\\n  -H \"apikey: <your-anon-key>\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{{\"group_id\":\"{SelectedGroupId}\"}}'";

                    <div class="endpoint-banner">
                        <div class="endpoint-label">🌐 Public endpoint</div>
                        <code class="endpoint-url">POST /rpc/get_public_group_notes</code>
                        <div class="endpoint-body-hint">Body: <code>{"{"}"group_id": "@g.Id"{"}"}</code></div>
                        <button class="copy-btn" @onclick="() => CopyEndpoint(curlExample)">Copy curl</button>
                    </div>
                }
            }
            <button class="nav-add" @onclick="() => showGroupModal = true">+ New Group</button>
            <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #f1f5f9;">
                <a class="nav-item" href="/rules">⚡ Auto-Group Rules</a>
            </div>
        </div>

        <!-- Tags Nav -->
        <div class="nav-section">
            <div class="nav-section-label">Tags</div>
            @foreach (var t in tags)
            {
                <a class="nav-item @(SelectedTagId == t.Id ? "active" : "")"
                   @onclick="() => SelectTag(t.Id)">
                    <span class="tag-pill" style="background:@(t.Color)22;color:@t.Color">@t.Name</span>
                </a>
            }
            <button class="nav-add" @onclick="() => showTagModal = true">+ New Tag</button>
        </div>

        <!-- Projects Nav -->
        <div class="nav-section">
            <div class="nav-section-label">Projects</div>
            @foreach (var proj in projects)
            {
                <a class="nav-item @(SelectedProjectId == proj.Id ? "active" : "")"
                   @onclick="() => SelectProject(proj.Id)">
                    <span class="nav-icon">📁</span>
                    <span style="flex:1">@proj.Name</span>
                    @if (proj.Tag != null)
                    {
                        <span class="tag-pill" style="background:@(proj.Tag.Color)22;color:@proj.Tag.Color;font-size:11px;">
                            @proj.Tag.Name
                        </span>
                    }
                </a>
            }
            <button class="nav-add" @onclick="() => showProjectModal = true">+ New Project</button>
        </div>

    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Top Bar -->
        <div class="topbar">
            <div class="search-wrap">
                <span class="search-icon">🔍</span>
                <input class="search-input" placeholder="Search notes…"
                       @bind="SearchQuery" @bind:event="oninput" />
            </div>
            <div class="topbar-actions">
                <BSButton Color="BSColor.Light" Size="Size.Small" @onclick="LoadData">⟳ Refresh</BSButton>
            </div>
        </div>

        <!-- Active project banner -->
        @if (SelectedProjectId != null)
        {
            var activeProject = projects.FirstOrDefault(p => p.Id == SelectedProjectId);
            if (activeProject != null)
            {
                <div class="project-banner">
                    <span>📁 <strong>@activeProject.Name</strong></span>
                    @if (activeProject.Tag != null)
                    {
                        <span class="tag-pill" style="background:@(activeProject.Tag.Color)22;color:@activeProject.Tag.Color">
                            #@activeProject.Tag.Name
                        </span>
                    }
                    <span style="color:#64748b;font-size:13px;">@filteredNotes.Count note@(filteredNotes.Count == 1 ? "" : "s")</span>
                    <div style="margin-left:auto;display:flex;gap:8px;align-items:center;">
                        <BSButton Color="BSColor.Primary" Size="Size.Small"
                                  @onclick="() => OpenExportModal(null, activeProject)">
                            ⬇ Export All
                        </BSButton>
                        <button class="project-banner-delete" @onclick="() => DeleteProject(activeProject.Id)">
                            🗑 Delete Project
                        </button>
                    </div>
                </div>
            }
        }

        <!-- Notes Grid -->
        @if (loading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Loading notes…</p>
            </div>
        }
        else if (!filteredNotes.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📝</div>
                <h3>No notes found</h3>
                <p>Notes added from the mobile app will appear here.</p>
            </div>
        }
        else
        {
            <div class="notes-grid">
                @foreach (var note in filteredNotes)
                {
                    var templateType = note.Group?.TemplateType ?? GroupTemplateType.Standard;
                    var isTaskOrAssignment = note.NoteType == NoteType.Task || note.NoteType == NoteType.Assignment;
                    var isComplete = note.Metadata.IsComplete == true;

                    @* ── Link card (compact) ── *@
                    @if (templateType == GroupTemplateType.Link)
                    {
                        <div class="note-card note-card--link @(selectedNote?.Id == note.Id ? "selected" : "") @(_highlightedNoteIds.Contains(note.Id) ? "note-highlight" : "") @(isComplete ? "note-card--complete" : "")"
                             @onclick="() => SelectNote(note)">
                            <div class="link-card-icon">🔗</div>
                            <div class="link-card-body">
                                <div class="task-card-header">
                                    @if (isTaskOrAssignment)
                                    {
                                        <button class="task-checkbox @(isComplete ? "checked" : "")"
                                                @onclick:stopPropagation
                                                @onclick="() => ToggleComplete(note)">
                                            @if (isComplete) { <span>✓</span> }
                                        </button>
                                    }
                                    <div class="link-card-title @(isComplete ? "note-title--struck" : "")">@note.Title</div>
                                </div>
                                @if (!string.IsNullOrEmpty(note.Metadata.Url))
                                {
                                    <div class="link-card-url">@note.Metadata.Url</div>
                                }
                                @if (isTaskOrAssignment)
                                {
                                    @NoteTypeDueDateFragment(note)
                                }
                                <div class="note-meta" style="margin-top:6px;">
                                    @note.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")
                                </div>
                                @if (SelectedProjectId != null)
                                {
                                    <div class="note-card-export-row">
                                        <button class="note-export-btn" @onclick:stopPropagation
                                                @onclick="() => OpenExportModal(note, null)">
                                            ⬇ Export
                                        </button>
                                        <button class="note-export-btn note-export-btn--jira" @onclick:stopPropagation
                                                @onclick="async () => await OpenJiraModal(note)">
                                            ☁ Jira
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* ── Dev Note card ── *@
                    else if (templateType == GroupTemplateType.DevNote)
                    {
                        <div class="note-card note-card--dev @(selectedNote?.Id == note.Id ? "selected" : "") @(_highlightedNoteIds.Contains(note.Id) ? "note-highlight" : "") @(isComplete ? "note-card--complete" : "")"
                             @onclick="() => SelectNote(note)">
                            <div class="dev-card-header">
                                <span class="dev-card-lang">@(note.Metadata.Language ?? "—")</span>
                                @if (!string.IsNullOrEmpty(note.Metadata.Status))
                                {
                                    <span class="dev-card-status dev-status--@note.Metadata.Status.ToLower().Replace(" ", "-")">
                                        @note.Metadata.Status
                                    </span>
                                }
                            </div>
                            <div class="note-card-body">
                                <div class="task-card-header">
                                    @if (isTaskOrAssignment)
                                    {
                                        <button class="task-checkbox @(isComplete ? "checked" : "")"
                                                @onclick:stopPropagation
                                                @onclick="() => ToggleComplete(note)">
                                            @if (isComplete) { <span>✓</span> }
                                        </button>
                                    }
                                    <h3 class="note-title @(isComplete ? "note-title--struck" : "")">@note.Title</h3>
                                </div>
                                @if (!string.IsNullOrEmpty(note.Metadata.Url))
                                {
                                    <div class="dev-card-url">🔗 @note.Metadata.Url</div>
                                }
                                @if (isTaskOrAssignment)
                                {
                                    @NoteTypeDueDateFragment(note)
                                }
                                @if (!string.IsNullOrEmpty(note.Body))
                                {
                                    <p class="note-preview">@Truncate(note.Body, 80)</p>
                                }
                                <div class="note-tags">
                                    @foreach (var tag in note.Tags)
                                    {
                                        <span class="tag-badge" style="background:@(tag.Color)22;color:@tag.Color">@tag.Name</span>
                                    }
                                </div>
                                <div class="note-meta">@note.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</div>
                                @if (SelectedProjectId != null)
                                {
                                    <div class="note-card-export-row">
                                        <button class="note-export-btn" @onclick:stopPropagation
                                                @onclick="() => OpenExportModal(note, null)">
                                            ⬇ Export
                                        </button>
                                        <button class="note-export-btn note-export-btn--jira" @onclick:stopPropagation
                                                @onclick="async () => await OpenJiraModal(note)">
                                            ☁ Jira
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* ── Task / Assignment card (group template) ── *@
                    else if (templateType == GroupTemplateType.Task || templateType == GroupTemplateType.Assignment)
                    {
                        <div class="note-card note-card--task @(selectedNote?.Id == note.Id ? "selected" : "") @(_highlightedNoteIds.Contains(note.Id) ? "note-highlight" : "") @(isComplete ? "note-card--complete" : "")"
                             @onclick="() => SelectNote(note)">
                            <div class="note-card-body">
                                <div class="task-card-header">
                                    <button class="task-checkbox @(isComplete ? "checked" : "")"
                                            @onclick:stopPropagation
                                            @onclick="() => ToggleComplete(note)">
                                        @if (isComplete) { <span>✓</span> }
                                    </button>
                                    <h3 class="note-title @(isComplete ? "note-title--struck" : "")">
                                        @note.Title
                                    </h3>
                                </div>
                                @NoteTypeDueDateFragment(note)
                                @if (!string.IsNullOrEmpty(note.Body))
                                {
                                    <p class="note-preview">@Truncate(note.Body, 80)</p>
                                }
                                <div class="note-tags">
                                    @foreach (var tag in note.Tags)
                                    {
                                        <span class="tag-badge" style="background:@(tag.Color)22;color:@tag.Color">@tag.Name</span>
                                    }
                                </div>
                                <div class="note-meta">@note.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</div>
                                @if (SelectedProjectId != null)
                                {
                                    <div class="note-card-export-row">
                                        <button class="note-export-btn" @onclick:stopPropagation
                                                @onclick="() => OpenExportModal(note, null)">
                                            ⬇ Export
                                        </button>
                                        <button class="note-export-btn note-export-btn--jira" @onclick:stopPropagation
                                                @onclick="async () => await OpenJiraModal(note)">
                                            ☁ Jira
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* ── Standard card (default) ── *@
                    else
                    {
                        <div class="note-card @(selectedNote?.Id == note.Id ? "selected" : "") @(_highlightedNoteIds.Contains(note.Id) ? "note-highlight" : "") @(isComplete ? "note-card--complete" : "")"
                             @onclick="() => SelectNote(note)">
                            @if (!string.IsNullOrEmpty(note.PhotoUrl))
                            {
                                <div class="note-photo-wrap">
                                    <img src="@note.PhotoUrl" class="note-photo" alt="Note photo" />
                                </div>
                            }
                            <div class="note-card-body">
                                @if (note.Group != null)
                                {
                                    <div class="note-group-badge" style="color:@note.Group.Color">
                                        <span class="group-dot" style="background:@note.Group.Color"></span>
                                        @note.Group.Name
                                    </div>
                                }
                                <div class="task-card-header">
                                    @if (isTaskOrAssignment)
                                    {
                                        <button class="task-checkbox @(isComplete ? "checked" : "")"
                                                @onclick:stopPropagation
                                                @onclick="() => ToggleComplete(note)">
                                            @if (isComplete) { <span>✓</span> }
                                        </button>
                                    }
                                    <h3 class="note-title @(isComplete ? "note-title--struck" : "")">@note.Title</h3>
                                </div>
                                @if (isTaskOrAssignment)
                                {
                                    @NoteTypeDueDateFragment(note)
                                }
                                @if (!string.IsNullOrEmpty(note.Body))
                                {
                                    <p class="note-preview">@Truncate(note.Body, 120)</p>
                                }
                                <div class="note-tags">
                                    @foreach (var tag in note.Tags)
                                    {
                                        <span class="tag-badge" style="background:@(tag.Color)22;color:@tag.Color">@tag.Name</span>
                                    }
                                </div>
                                @if (SelectedProjectId != null)
                                {
                                    <div class="note-card-export-row">
                                        <button class="note-export-btn" @onclick:stopPropagation
                                                @onclick="() => OpenExportModal(note, null)">
                                            ⬇ Export
                                        </button>
                                        <button class="note-export-btn note-export-btn--jira" @onclick:stopPropagation
                                                @onclick="async () => await OpenJiraModal(note)">
                                            ☁ Jira
                                        </button>
                                    </div>
                                }
                                <div class="note-meta">@note.UpdatedAt.ToLocalTime().ToString("MMM d, yyyy")</div>
                            </div>
                        </div>
                    }
                }
            </div>
        }

    </main>

    <!-- Detail Panel -->
    @if (selectedNote != null)
    {
        var detailTemplate = selectedNote.Group?.TemplateType ?? GroupTemplateType.Standard;
        var detailIsTask = selectedNote.NoteType == NoteType.Task || selectedNote.NoteType == NoteType.Assignment;
        var detailIsAssignment = selectedNote.NoteType == NoteType.Assignment;

        <aside class="detail-panel">
            <div class="detail-header">
                <div class="detail-header-left">
                    @if (selectedNote.Group != null)
                    {
                        <span class="detail-template-badge">
                            @selectedNote.Group.TemplateIcon @selectedNote.Group.Name
                        </span>
                    }
                </div>
                <button class="detail-close" @onclick="() => selectedNote = null">✕</button>
            </div>

            @* Photo (standard only) *@
            @if (detailTemplate == GroupTemplateType.Standard && !string.IsNullOrEmpty(selectedNote.PhotoUrl))
            {
                <img src="@selectedNote.PhotoUrl" class="detail-photo" alt="Note photo" />
            }

            @* Title *@
            <div class="detail-section">
                <label class="detail-label">Title</label>
                <input class="detail-input"
                       @bind="selectedNote.Title"
                       @bind:event="onchange"
                       @bind:after="SaveTitle"
                       placeholder="Note title…" />
            </div>

            @* Note Type *@
            <div class="detail-section">
                <label class="detail-label">Type</label>
                <select class="detail-select"
                        @onchange="async e => await ChangeNoteType(e.Value?.ToString())">
                    <option value="note"       selected="@(selectedNote.NoteTypeRaw == "note")">📄 Note</option>
                    <option value="task"       selected="@(selectedNote.NoteTypeRaw == "task")">☑️ Task</option>
                    <option value="assignment" selected="@(selectedNote.NoteTypeRaw == "assignment")">📅 Assignment</option>
                </select>
            </div>

            @* Task / Assignment — completion toggle *@
            @if (detailIsTask)
            {
                <div class="detail-section">
                    <label class="detail-label">Status</label>
                    <div class="task-complete-row">
                        <button class="task-checkbox-large @(selectedNote.Metadata.IsComplete == true ? "checked" : "")"
                                @onclick="() => ToggleComplete(selectedNote)">
                            @if (selectedNote.Metadata.IsComplete == true) { <span>✓</span> }
                        </button>
                        <span class="task-complete-label">
                            @(selectedNote.Metadata.IsComplete == true ? "Complete" : "Incomplete")
                        </span>
                    </div>
                </div>
            }

            @* Assignment — due date *@
            @if (detailIsAssignment)
            {
                <div class="detail-section">
                    <label class="detail-label">Due Date</label>
                    <input type="date" class="detail-input"
                           value="@selectedNote.Metadata.DueDate"
                           @onchange="async e => { var v = e.Value?.ToString(); await UpdateMetadataField(MetaField.DueDate, v); }" />
                </div>
            }

            @* Dev Note fields *@
            @if (detailTemplate == GroupTemplateType.DevNote)
            {
                <div class="detail-section">
                    <label class="detail-label">URL</label>
                    <input class="detail-input" placeholder="https://…"
                           value="@selectedNote.Metadata.Url"
                           @onchange="async e => { var v = e.Value?.ToString(); await UpdateMetadataField(MetaField.Url, v); }" />
                </div>
                <div class="detail-section">
                    <label class="detail-label">Language / Tech</label>
                    <input class="detail-input" placeholder="e.g. C#, TypeScript, SQL…"
                           value="@selectedNote.Metadata.Language"
                           @onchange="async e => { var v = e.Value?.ToString(); await UpdateMetadataField(MetaField.Language, v); }" />
                </div>
                <div class="detail-section">
                    <label class="detail-label">Status</label>
                    <select class="detail-select"
                            @onchange="async e => { var v = e.Value?.ToString(); await UpdateMetadataField(MetaField.Status, v); }">
                        <option value="" selected="@(string.IsNullOrEmpty(selectedNote.Metadata.Status))">— None —</option>
                        <option value="In Progress" selected="@(selectedNote.Metadata.Status == "In Progress")">In Progress</option>
                        <option value="Review"      selected="@(selectedNote.Metadata.Status == "Review")">Review</option>
                        <option value="Done"        selected="@(selectedNote.Metadata.Status == "Done")">Done</option>
                        <option value="Blocked"     selected="@(selectedNote.Metadata.Status == "Blocked")">Blocked</option>
                    </select>
                </div>
            }

            @* Link fields *@
            @if (detailTemplate == GroupTemplateType.Link)
            {
                <div class="detail-section">
                    <label class="detail-label">URL</label>
                    <input class="detail-input" placeholder="https://…"
                           value="@selectedNote.Metadata.Url"
                           @onchange="async e => { var v = e.Value?.ToString(); await UpdateMetadataField(MetaField.Url, v); }" />
                </div>
                @if (!string.IsNullOrEmpty(selectedNote.Metadata.Url))
                {
                    <div class="detail-section">
                        <a class="link-open-btn" href="@selectedNote.Metadata.Url" target="_blank">
                            ↗ Open Link
                        </a>
                    </div>
                }
            }

            @* Body (not shown for Link cards) *@
            @if (detailTemplate != GroupTemplateType.Link)
            {
                <div class="detail-section">
                    <label class="detail-label">Content</label>
                    <div class="detail-body">@selectedNote.Body</div>
                </div>
            }

            @* Group selector *@
            <div class="detail-section">
                <label class="detail-label">Group</label>
                <select class="detail-select" value="@selectedNote.GroupId"
                        @onchange="async e => await ChangeGroup(e.Value?.ToString())">
                    <option value="">— None —</option>
                    @foreach (var g in groups)
                    {
                        <option value="@g.Id">@g.TemplateIcon @g.Name</option>
                    }
                </select>
            </div>

            @* Tags *@
            <div class="detail-section">
                <label class="detail-label">Tags</label>
                <div class="detail-tag-list">
                    @foreach (var tag in tags)
                    {
                        var active = selectedNote.Tags.Any(t => t.Id == tag.Id);
                        <button class="tag-toggle @(active ? "active" : "")"
                                style="@(active ? $"background:{tag.Color};color:#fff;border-color:{tag.Color}"
                                                : $"border-color:{tag.Color};color:{tag.Color}")"
                                @onclick="() => ToggleTag(tag)">
                            @tag.Name
                        </button>
                    }
                </div>
            </div>

            <div class="detail-footer">
                <BSButton Color="BSColor.Danger" Size="Size.Small" @onclick="ConfirmDelete">
                    🗑 Delete
                </BSButton>
                <span class="detail-date">
                    @selectedNote.UpdatedAt.ToLocalTime().ToString("MMM d, h:mm tt")
                </span>
            </div>
        </aside>
    }

</div>

<!-- Group Modal -->
@if (showGroupModal)
{
    <div class="modal-backdrop" @onclick="() => showGroupModal = false">
        <div class="modal-card" @onclick:stopPropagation>
            <h3 class="modal-title">New Group</h3>
            <label class="form-label">Name</label>
            <input class="form-control mb-3" @bind="newGroupName" placeholder="Group name…" />
            <label class="form-label">Template Type</label>
            <div class="template-type-grid">
                @foreach (var t in TemplateOptions)
                {
                    <button class="template-type-btn @(newGroupTemplate == t.Value ? "selected" : "")"
                            @onclick="() => newGroupTemplate = t.Value">
                        <span class="template-type-icon">@t.Icon</span>
                        <span class="template-type-label">@t.Label</span>
                        <span class="template-type-desc">@t.Desc</span>
                    </button>
                }
            </div>
            <label class="form-label" style="margin-top:16px;">Color</label>
            <div class="color-palette">
                @foreach (var c in ColorPalette)
                {
                    <button class="color-swatch @(newGroupColor == c ? "selected" : "")"
                            style="background:@c" @onclick="() => newGroupColor = c"></button>
                }
            </div>
            <div class="modal-actions">
                <BSButton Color="BSColor.Light" @onclick="() => showGroupModal = false">Cancel</BSButton>
                <BSButton Color="BSColor.Primary" @onclick="CreateGroup">Create</BSButton>
            </div>
        </div>
    </div>
}

<!-- Tag Modal -->
@if (showTagModal)
{
    <div class="modal-backdrop" @onclick="() => showTagModal = false">
        <div class="modal-card" @onclick:stopPropagation>
            <h3 class="modal-title">New Tag</h3>
            <label class="form-label">Name</label>
            <input class="form-control mb-3" @bind="newTagName" placeholder="Tag name…" />
            <label class="form-label">Color</label>
            <div class="color-palette">
                @foreach (var c in ColorPalette)
                {
                    <button class="color-swatch @(newTagColor == c ? "selected" : "")"
                            style="background:@c" @onclick="() => newTagColor = c"></button>
                }
            </div>
            <div class="modal-actions">
                <BSButton Color="BSColor.Light" @onclick="() => showTagModal = false">Cancel</BSButton>
                <BSButton Color="BSColor.Primary" @onclick="CreateTag">Create</BSButton>
            </div>
        </div>
    </div>
}

<!-- Project Modal -->
@if (showProjectModal)
{
    <div class="modal-backdrop" @onclick="() => showProjectModal = false">
        <div class="modal-card" @onclick:stopPropagation>
            <h3 class="modal-title">New Project</h3>
            <label class="form-label">Name</label>
            <input class="form-control mb-3" @bind="newProjectName" placeholder="Project name…" />
            <label class="form-label">Linked Tag</label>
            <select class="form-select mb-3" @bind="newProjectTagId">
                <option value="">— No tag —</option>
                @foreach (var t in tags)
                {
                    <option value="@t.Id">@t.Name</option>
                }
            </select>
            <p style="font-size:12px;color:#94a3b8;margin-top:-8px;">
                Notes tagged with this tag will appear in the project view.
            </p>
            <div class="modal-actions">
                <BSButton Color="BSColor.Light" @onclick="() => showProjectModal = false">Cancel</BSButton>
                <BSButton Color="BSColor.Primary" @onclick="CreateProject">Create</BSButton>
            </div>
        </div>
    </div>
}

<!-- Export Format Modal -->
@if (showExportModal)
{
    <div class="modal-backdrop" @onclick="CloseExportModal">
        <div class="modal-card" @onclick:stopPropagation>
            <h3 class="modal-title">⬇ Export</h3>

            @if (exportIsBulk)
            {
                <p class="export-modal-subtitle">
                    Exporting <strong>@filteredNotes.Count note@(filteredNotes.Count == 1 ? "" : "s")</strong>
                    from <strong>@exportBulkProjectName</strong>
                </p>
            }
            else
            {
                <p class="export-modal-subtitle">
                    Exporting <strong>@exportNote?.Title</strong>
                </p>
            }

            <div class="export-format-grid">
                <button class="export-format-btn" @onclick='() => RunExport("json")'>
                    <span class="export-format-icon">📄</span>
                    <span class="export-format-label">JSON</span>
                    <span class="export-format-desc">Structured data</span>
                </button>
                <button class="export-format-btn" @onclick='() => RunExport("markdown")'>
                    <span class="export-format-icon">📝</span>
                    <span class="export-format-label">Markdown</span>
                    <span class="export-format-desc">.md file</span>
                </button>
                <button class="export-format-btn" @onclick='() => RunExport("csv")'>
                    <span class="export-format-icon">📊</span>
                    <span class="export-format-label">CSV</span>
                    <span class="export-format-desc">Spreadsheet</span>
                </button>
                <button class="export-format-btn" @onclick='() => RunExport("pdf")'>
                    <span class="export-format-icon">🖨</span>
                    <span class="export-format-label">PDF</span>
                    <span class="export-format-desc">Print / save</span>
                </button>
                <button class="export-format-btn" @onclick='() => RunExport("clipboard")'>
                    <span class="export-format-icon">📋</span>
                    <span class="export-format-label">Clipboard</span>
                    <span class="export-format-desc">Copy to paste</span>
                </button>
            </div>

            @if (exportFeedback != null)
            {
                <div class="settings-feedback @(exportFeedbackSuccess ? "feedback--success" : "feedback--error")"
                     style="margin-top:12px;">
                    @exportFeedback
                </div>
            }

            <div class="modal-actions" style="margin-top:16px;">
                <BSButton Color="BSColor.Light" @onclick="CloseExportModal">Close</BSButton>
            </div>
        </div>
    </div>
}

<!-- Jira Export Modal -->
@if (showJiraModal && jiraNote != null)
{
    <div class="modal-backdrop" @onclick="CloseJiraModal">
        <div class="modal-card" @onclick:stopPropagation>
            <h3 class="modal-title">☁ Export to Jira</h3>

            @if (!jiraConnected)
            {
                <div class="jira-connect-prompt">
                    <p style="color:#64748b;font-size:14px;margin-bottom:12px;">
                        Connect your Jira account to send notes as issues.
                    </p>
                    <a class="jira-connect-btn" href="http://localhost:5100/jira/auth" target="_blank"
                       @onclick="() => _ = PollForJiraConnection()">
                        🔗 Connect to Jira
                    </a>
                </div>
            }
            else
            {
                <div class="settings-feedback feedback--success" style="margin-bottom:12px;">
                    ✅ Connected to Jira
                </div>

                <label class="form-label">Summary (title)</label>
                <input class="form-control mb-3" @bind="jiraSummary" />

                <label class="form-label">Description</label>
                <textarea class="form-control mb-3" rows="4" @bind="jiraBody"></textarea>

                <label class="form-label">Project</label>
                @if (jiraCheckingStatus)
                {
                    <p style="font-size:13px;color:#94a3b8;">Loading projects…</p>
                }
                else if (jiraProjects.Any())
                {
                    <select class="form-select mb-3"
                            @onchange="async e => await OnJiraProjectChanged(e.Value?.ToString())">
                        @foreach (var p in jiraProjects)
                        {
                            <option value="@p.Key">@p.Name (@p.Key)</option>
                        }
                    </select>
                }
                else
                {
                    <input class="form-control mb-3" placeholder="e.g. NK" @bind="jiraProjectKey" />
                }

                <label class="form-label">Issue Type</label>
                @if (jiraIssueTypes.Any())
                {
                    <select class="form-select mb-3" @bind="jiraIssueTypeId">
                        @foreach (var t in jiraIssueTypes)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                }
                else
                {
                    <select class="form-select mb-3" @bind="jiraIssueTypeId">
                        <option value="">— Select project first —</option>
                    </select>
                }
            }

            @if (jiraErrorMessage != null)
            {
                <div class="settings-feedback feedback--error" style="margin-bottom:12px;">
                    ❌ @jiraErrorMessage
                </div>
            }
            @if (jiraSuccessUrl != null)
            {
                <div class="settings-feedback feedback--success" style="margin-bottom:12px;">
                    ✅ Issue created!
                    <a href="@jiraSuccessUrl" target="_blank" style="margin-left:6px;">
                        View in Jira ↗
                    </a>
                </div>
            }

            <div class="modal-actions">
                <BSButton Color="BSColor.Light" @onclick="CloseJiraModal">Cancel</BSButton>
                @if (jiraConnected)
                {
                    <BSButton Color="BSColor.Primary" @onclick="SendToJira" Disabled="@jiraSending">
                        @(jiraSending ? "Sending…" : "Send to Jira")
                    </BSButton>
                }
            </div>
        </div>
    </div>
}
@code {
    private List<Note> notes = new();
    private List<Note> filteredNotes = new();
    private List<Group> groups = new();
    private List<Tag> tags = new();
    private List<Project> projects = new();
    private Note? selectedNote;
    private bool loading = true;

    private string? SelectedGroupId;
    private string? SelectedTagId;
    private string? SelectedProjectId;

    private string _searchQuery = "";
    private string SearchQuery
    {
        get => _searchQuery;
        set { _searchQuery = value; ApplyFilters(); }
    }

    private bool showGroupModal;
    private bool showTagModal;
    private bool showProjectModal;

    private string newGroupName = "";
    private string newGroupColor = "#6366f1";
    private string newTagName = "";
    private string newTagColor = "#10b981";
    private string newProjectName = "";
    private string newProjectTagId = "";
    private string newGroupTemplate = "standard";

    private static readonly string[] ColorPalette = {
        "#6366f1","#10b981","#f59e0b","#ef4444",
        "#8b5cf6","#06b6d4","#f97316","#ec4899"
    };

    private record TemplateOption(string Value, string Icon, string Label, string Desc);
    private static readonly TemplateOption[] TemplateOptions =
    {
        new("standard",   "📄", "Standard",   "Title + body"),
        new("task",       "☑️", "Task",        "Checkbox + status"),
        new("assignment", "📅", "Assignment",  "Task + due date"),
        new("dev_note",   "💻", "Dev Note",    "URL, language, status"),
        new("link",       "🔗", "Link",        "Compact URL card"),
    };

    private enum MetaField { Url, Language, Status, DueDate }

    private HashSet<string> _highlightedNoteIds = new();
    private string? _toastMessage;
    private bool _showToast;
    private System.Threading.Timer? _toastTimer;
    private System.Threading.Timer? _highlightTimer;
    private CancellationTokenSource _pollingCts = new();

    // ── Export modal state ─────────────────────────────────────────────
    private bool showExportModal;
    private Note? exportNote;           // null = bulk mode
    private bool exportIsBulk;
    private string exportBulkProjectName = "";
    private string? exportFeedback;
    private bool exportFeedbackSuccess;

    // ── Jira modal state ───────────────────────────────────────────────
    // ── Jira modal state ───────────────────────────────────────────────
    private bool showJiraModal;
    private Note? jiraNote;
    private string jiraSummary = "";
    private string jiraBody = "";
    private string jiraProjectKey = "";
    private string jiraIssueTypeId = "";
    private bool jiraSending;
    private string? jiraErrorMessage;
    private string? jiraSuccessUrl;
    private bool jiraConnected;
    private bool jiraCheckingStatus;
    private List<JiraProject> jiraProjects = new();
    private List<JiraIssueType> jiraIssueTypes = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        _ = StartPollingAsync();

        jiraConnected = await Svc.GetJiraStatusAsync();
    }

    private async Task LoadData()
    {
        loading = true;
        notes = await Svc.GetNotesAsync();
        groups = await Svc.GetGroupsAsync();
        tags = await Svc.GetTagsAsync();
        projects = await Svc.GetProjectsAsync();
        ApplyFilters();
        loading = false;

        if (selectedNote != null)
            selectedNote = notes.FirstOrDefault(n => n.Id == selectedNote.Id);
    }

    private async Task StartPollingAsync()
    {
        while (!_pollingCts.IsCancellationRequested)
        {
            await Task.Delay(30000, _pollingCts.Token).ContinueWith(_ => Task.CompletedTask);
            if (_pollingCts.IsCancellationRequested) break;

            var fresh = await Svc.GetNotesAsync();
            var newNotes = fresh.Where(f => notes.All(n => n.Id != f.Id)).ToList();

            foreach (var note in newNotes)
            {
                notes.Insert(0, note);
                _highlightedNoteIds.Add(note.Id);
                ShowToast($"New note arrived: \"{note.Title}\"");
                _ = Task.Delay(4000).ContinueWith(_ =>
                {
                    _highlightedNoteIds.Remove(note.Id);
                    InvokeAsync(StateHasChanged);
                });
            }

            foreach (var fresh_note in fresh)
            {
                var idx = notes.FindIndex(n => n.Id == fresh_note.Id);
                if (idx >= 0) notes[idx] = fresh_note;
            }

            notes.RemoveAll(n => fresh.All(f => f.Id != n.Id));

            if (newNotes.Any())
                ApplyFilters();

            await InvokeAsync(StateHasChanged);
        }
    }

    private void ShowToast(string message)
    {
        _toastMessage = message;
        _showToast = true;
        _toastTimer?.Dispose();
        _toastTimer = new System.Threading.Timer(_ =>
        {
            _showToast = false;
            InvokeAsync(StateHasChanged);
        }, null, 3500, System.Threading.Timeout.Infinite);
    }

    private void ApplyFilters()
    {
        var query = notes.AsEnumerable();

        if (!string.IsNullOrEmpty(SelectedGroupId))
            query = query.Where(n => n.GroupId == SelectedGroupId);

        if (!string.IsNullOrEmpty(SelectedTagId))
            query = query.Where(n => n.Tags.Any(t => t.Id == SelectedTagId));

        if (!string.IsNullOrEmpty(SelectedProjectId))
        {
            var proj = projects.FirstOrDefault(p => p.Id == SelectedProjectId);
            if (proj?.TagId != null)
                query = query.Where(n => n.Tags.Any(t => t.Id == proj.TagId));
        }

        if (!string.IsNullOrEmpty(_searchQuery))
            query = query.Where(n =>
                n.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                (n.Body?.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ?? false));

        filteredNotes = query.ToList();
    }

    private void SelectGroup(string? id)
    {
        SelectedGroupId = id;
        SelectedTagId = null;
        SelectedProjectId = null;
        ApplyFilters();
    }

    private void SelectTag(string id)
    {
        SelectedTagId = SelectedTagId == id ? null : id;
        SelectedGroupId = null;
        SelectedProjectId = null;
        ApplyFilters();
    }

    private void SelectProject(string id)
    {
        SelectedProjectId = SelectedProjectId == id ? null : id;
        SelectedGroupId = null;
        SelectedTagId = null;
        ApplyFilters();
    }

    private void SelectNote(Note note) => selectedNote = note;

    private async Task ChangeGroup(string? groupId)
    {
        if (selectedNote == null) return;
        selectedNote.GroupId = string.IsNullOrEmpty(groupId) ? null : groupId;
        selectedNote.Group = groups.FirstOrDefault(g => g.Id == groupId);
        await Svc.UpdateNoteAsync(selectedNote);
        await LoadData();
    }

    private async Task ChangeNoteType(string? noteType)
    {
        if (selectedNote == null || string.IsNullOrEmpty(noteType)) return;
        selectedNote.NoteTypeRaw = noteType;
        if (noteType is "task" or "assignment")
            selectedNote.Metadata.IsComplete ??= false;
        selectedNote.InvalidateMetadataCache();
        await Svc.UpdateNoteAsync(selectedNote);
        await LoadData();
    }

    private async Task ToggleTag(Tag tag)
    {
        if (selectedNote == null) return;
        if (selectedNote.Tags.Any(t => t.Id == tag.Id))
            selectedNote.Tags.RemoveAll(t => t.Id == tag.Id);
        else
            selectedNote.Tags.Add(tag);

        var tagIds = selectedNote.Tags.Select(t => t.Id).ToList();
        await Svc.SetNoteTagsAsync(selectedNote.Id, tagIds);

        var matchedGroupId = await Svc.ApplyRulesAsync(tagIds);
        if (matchedGroupId != null && selectedNote.GroupId == null)
        {
            selectedNote.GroupId = matchedGroupId;
            selectedNote.Group = groups.FirstOrDefault(g => g.Id == matchedGroupId);
            await Svc.UpdateNoteAsync(selectedNote);
        }

        await LoadData();
    }

    private async Task ConfirmDelete()
    {
        if (selectedNote == null) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete \"{selectedNote.Title}\"? This cannot be undone.");
        if (confirmed)
        {
            await Svc.DeleteNoteAsync(selectedNote.Id);
            selectedNote = null;
            await LoadData();
        }
    }

    private async Task DeleteSelected()
    {
        if (selectedNote == null) return;
        await Svc.DeleteNoteAsync(selectedNote.Id);
        selectedNote = null;
        await LoadData();
    }

    private async Task CreateGroup()
    {
        if (string.IsNullOrWhiteSpace(newGroupName)) return;
        await Svc.CreateGroupAsync(newGroupName, newGroupColor, newGroupTemplate);
        newGroupName = "";
        newGroupColor = "#6366f1";
        newGroupTemplate = "standard";
        showGroupModal = false;
        await LoadData();
    }

    private async Task CreateTag()
    {
        if (string.IsNullOrWhiteSpace(newTagName)) return;
        await Svc.CreateTagAsync(newTagName.Trim(), newTagColor);
        newTagName = ""; showTagModal = false;
        await LoadData();
    }

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(newProjectName)) return;
        await Svc.CreateProjectAsync(newProjectName.Trim(), string.IsNullOrEmpty(newProjectTagId) ? null : newProjectTagId);
        newProjectName = "";
        newProjectTagId = "";
        showProjectModal = false;
        await LoadData();
    }

    private async Task DeleteProject(string projectId)
    {
        await Svc.DeleteProjectAsync(projectId);
        SelectedProjectId = null;
        await LoadData();
    }

    // ── Export modal ───────────────────────────────────────────────────

    private void OpenExportModal(Note? note, Project? project)
    {
        exportNote = note;
        exportIsBulk = note == null;
        exportBulkProjectName = project?.Name ?? "";
        exportFeedback = null;
        exportFeedbackSuccess = false;
        showExportModal = true;
    }

    private void CloseExportModal()
    {
        showExportModal = false;
        exportNote = null;
        exportFeedback = null;
    }

    private async Task RunExport(string format)
    {
        exportFeedback = null;
        var notesToExport = exportIsBulk ? filteredNotes : new List<Note> { exportNote! };
        var baseName = exportIsBulk
            ? Slugify(exportBulkProjectName)
            : Slugify(exportNote!.Title);

        try
        {
            switch (format)
            {
                case "json":
                    await ExportJson(notesToExport, baseName);
                    break;
                case "markdown":
                    await ExportMarkdown(notesToExport, baseName);
                    break;
                case "csv":
                    await ExportCsv(notesToExport, baseName);
                    break;
                case "pdf":
                    await ExportPdf(notesToExport, baseName);
                    break;
                case "clipboard":
                    await ExportClipboard(notesToExport);
                    break;
            }

            if (format != "clipboard")
            {
                exportFeedbackSuccess = true;
                exportFeedback = "✅ Download started.";
            }
        }
        catch (Exception ex)
        {
            exportFeedbackSuccess = false;
            exportFeedback = $"❌ Export failed: {ex.Message}";
        }
    }

    private async Task ExportJson(List<Note> notesToExport, string baseName)
    {
        object export = exportIsBulk
            ? (object)new
            {
                project = exportBulkProjectName,
                exported_at = DateTime.UtcNow,
                notes = notesToExport.Select(NoteToExportShape).ToList()
            }
            : NoteToExportShape(notesToExport[0]);

        var json = JsonSerializer.Serialize(export, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("downloadFile", baseName + ".json", json, "application/json");
    }

    private async Task ExportMarkdown(List<Note> notesToExport, string baseName)
    {
        var sb = new System.Text.StringBuilder();

        if (exportIsBulk)
        {
            sb.AppendLine($"# {exportBulkProjectName}");
            sb.AppendLine($"*Exported {DateTime.Now:MMM d, yyyy}*");
            sb.AppendLine();
            foreach (var n in notesToExport)
            {
                sb.AppendLine($"## {n.Title}");
                if (n.Tags.Any())
                    sb.AppendLine($"*Tags: {string.Join(", ", n.Tags.Select(t => t.Name))}*");
                if (n.Group != null)
                    sb.AppendLine($"*Group: {n.Group.Name}*");
                if (!string.IsNullOrEmpty(n.Metadata.DueDate))
                    sb.AppendLine($"*Due: {n.Metadata.DueDate}*");
                if (!string.IsNullOrEmpty(n.Metadata.Url))
                    sb.AppendLine($"*URL: {n.Metadata.Url}*");
                sb.AppendLine();
                if (!string.IsNullOrEmpty(n.Body))
                    sb.AppendLine(n.Body);
                sb.AppendLine();
                sb.AppendLine("---");
                sb.AppendLine();
            }
        }
        else
        {
            var n = notesToExport[0];
            sb.AppendLine($"# {n.Title}");
            if (n.Tags.Any())
                sb.AppendLine($"*Tags: {string.Join(", ", n.Tags.Select(t => t.Name))}*");
            if (n.Group != null)
                sb.AppendLine($"*Group: {n.Group.Name}*");
            if (!string.IsNullOrEmpty(n.Metadata.DueDate))
                sb.AppendLine($"*Due: {n.Metadata.DueDate}*");
            if (!string.IsNullOrEmpty(n.Metadata.Url))
                sb.AppendLine($"*URL: {n.Metadata.Url}*");
            sb.AppendLine();
            if (!string.IsNullOrEmpty(n.Body))
                sb.AppendLine(n.Body);
        }

        await JS.InvokeVoidAsync("downloadFile", baseName + ".md", sb.ToString(), "text/markdown");
    }

    private async Task ExportCsv(List<Note> notesToExport, string baseName)
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("title,body,group,tags,due_date,url,language,status,is_complete,created_at,updated_at");

        foreach (var n in notesToExport)
        {
            sb.AppendLine(string.Join(",", new[]
            {
                CsvEscape(n.Title),
                CsvEscape(n.Body ?? ""),
                CsvEscape(n.Group?.Name ?? ""),
                CsvEscape(string.Join("|", n.Tags.Select(t => t.Name))),
                CsvEscape(n.Metadata.DueDate ?? ""),
                CsvEscape(n.Metadata.Url ?? ""),
                CsvEscape(n.Metadata.Language ?? ""),
                CsvEscape(n.Metadata.Status ?? ""),
                CsvEscape(n.Metadata.IsComplete?.ToString() ?? ""),
                CsvEscape(n.CreatedAt.ToString("o")),
                CsvEscape(n.UpdatedAt.ToString("o"))
            }));
        }

        await JS.InvokeVoidAsync("downloadFile", baseName + ".csv", sb.ToString(), "text/csv");
    }

    private async Task ExportPdf(List<Note> notesToExport, string baseName)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(@"<!DOCTYPE html>
<html>
<head>
<meta charset='utf-8'>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
         margin: 0; padding: 32px; color: #1e293b; background: #fff; }
  .nk-header { display: flex; align-items: center; gap: 10px;
                border-bottom: 2px solid #6366f1; padding-bottom: 12px; margin-bottom: 24px; }
  .nk-brand { font-size: 20px; font-weight: 700; color: #6366f1; }
  .nk-export-date { font-size: 12px; color: #94a3b8; margin-left: auto; }
  .nk-note { border: 1px solid #e2e8f0; border-radius: 10px;
              padding: 20px; margin-bottom: 20px; page-break-inside: avoid; }
  .nk-note-title { font-size: 17px; font-weight: 700; color: #1e293b; margin: 0 0 8px; }
  .nk-meta { font-size: 12px; color: #94a3b8; margin-bottom: 10px; }
  .nk-tag { display: inline-block; background: #ede9fe; color: #6d28d9;
             padding: 2px 8px; border-radius: 4px; font-size: 11px; margin-right: 4px; }
  .nk-body { font-size: 14px; color: #475569; line-height: 1.6;
              white-space: pre-wrap; margin-top: 10px; }
  .nk-field { font-size: 12px; color: #64748b; margin-top: 6px; }
  .nk-group-dot { display: inline-block; width: 8px; height: 8px;
                   border-radius: 50%; margin-right: 4px; background: #6366f1; }
  @media print { body { padding: 16px; } }
</style>
</head>
<body>");

        sb.Append($@"
<div class='nk-header'>
  <span class='nk-brand'>📋 NoteKeeper</span>
  {(exportIsBulk ? $"<span style='font-size:14px;color:#475569;'>{System.Net.WebUtility.HtmlEncode(exportBulkProjectName)}</span>" : "")}
  <span class='nk-export-date'>Exported {DateTime.Now:MMM d, yyyy}</span>
</div>");

        foreach (var n in notesToExport)
        {
            var groupColor = n.Group?.Color ?? "#6366f1";
            sb.Append($@"
<div class='nk-note'>
  <div class='nk-note-title'>{System.Net.WebUtility.HtmlEncode(n.Title)}</div>
  <div class='nk-meta'>");

            if (n.Group != null)
                sb.Append($"<span><span class='nk-group-dot' style='background:{groupColor}'></span>{System.Net.WebUtility.HtmlEncode(n.Group.Name)}</span> &nbsp;");

            foreach (var tag in n.Tags)
                sb.Append($"<span class='nk-tag'>{System.Net.WebUtility.HtmlEncode(tag.Name)}</span>");

            sb.Append($"<br><span>{n.UpdatedAt.ToLocalTime():MMM d, yyyy}</span>");
            sb.Append("</div>");

            if (!string.IsNullOrEmpty(n.Metadata.DueDate))
                sb.Append($"<div class='nk-field'>📅 Due: {System.Net.WebUtility.HtmlEncode(n.Metadata.DueDate)}</div>");
            if (!string.IsNullOrEmpty(n.Metadata.Url))
                sb.Append($"<div class='nk-field'>🔗 {System.Net.WebUtility.HtmlEncode(n.Metadata.Url)}</div>");
            if (!string.IsNullOrEmpty(n.Metadata.Language))
                sb.Append($"<div class='nk-field'>💻 {System.Net.WebUtility.HtmlEncode(n.Metadata.Language)}</div>");
            if (!string.IsNullOrEmpty(n.Metadata.Status))
                sb.Append($"<div class='nk-field'>⚡ {System.Net.WebUtility.HtmlEncode(n.Metadata.Status)}</div>");
            if (n.Metadata.IsComplete.HasValue)
                sb.Append($"<div class='nk-field'>{(n.Metadata.IsComplete.Value ? "✅ Complete" : "⬜ Incomplete")}</div>");

            if (!string.IsNullOrEmpty(n.Body))
                sb.Append($"<div class='nk-body'>{System.Net.WebUtility.HtmlEncode(n.Body)}</div>");

            sb.Append("</div>");
        }

        sb.Append("</body></html>");
        await JS.InvokeVoidAsync("printAsPdf", sb.ToString());

        exportFeedbackSuccess = true;
        exportFeedback = "✅ Print dialog opened — choose 'Save as PDF'.";
    }

    private async Task ExportClipboard(List<Note> notesToExport)
    {
        var sb = new System.Text.StringBuilder();

        foreach (var n in notesToExport)
        {
            sb.AppendLine(n.Title);
            if (!string.IsNullOrEmpty(n.Body))
                sb.AppendLine(n.Body);
            if (n.Tags.Any())
                sb.AppendLine($"Tags: {string.Join(", ", n.Tags.Select(t => t.Name))}");
            if (!string.IsNullOrEmpty(n.Metadata.DueDate))
                sb.AppendLine($"Due: {n.Metadata.DueDate}");
            if (!string.IsNullOrEmpty(n.Metadata.Url))
                sb.AppendLine(n.Metadata.Url);
            if (notesToExport.Count > 1)
                sb.AppendLine();
        }

        await JS.InvokeVoidAsync("copyToClipboard", sb.ToString().Trim());
        exportFeedbackSuccess = true;
        exportFeedback = "✅ Copied to clipboard.";
    }

