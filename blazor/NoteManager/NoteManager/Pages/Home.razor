    };

    private static string Slugify(string s) =>
        string.Concat(s.ToLower().Replace(" ", "-")
            .Where(c => char.IsLetterOrDigit(c) || c == '-'));

    private static string CsvEscape(string s)
    {
        if (s.Contains(',') || s.Contains('"') || s.Contains('\n'))
            return $"\"{s.Replace("\"", "\"\"")}\"";
        return s;
    }

    private static string Truncate(string s, int len) =>
        s.Length <= len ? s : s[..len] + "…";

    // ── Jira ───────────────────────────────────────────────────────────

    private async Task OpenJiraModal(Note note)
    {
        jiraNote = note;
        jiraSummary = note.Title;
        jiraBody = note.Body ?? "";
        jiraIssueTypeId = "";
        jiraErrorMessage = null;
        jiraSuccessUrl = null;
        jiraSending = false;
        jiraProjects = new();
        jiraIssueTypes = new();
        showJiraModal = true;

        if (jiraConnected)
        {
            jiraCheckingStatus = true;
            StateHasChanged();
            try
            {
                jiraProjects = await Svc.GetJiraProjectsAsync();
                if (jiraProjects.Any())
                {
                    jiraProjectKey = jiraProjects[0].Key;
                    jiraIssueTypes = await Svc.GetJiraIssueTypesAsync(jiraProjectKey);
                    if (jiraIssueTypes.Any()) jiraIssueTypeId = jiraIssueTypes[0].Id;
                }
            }
            catch { jiraErrorMessage = "Failed to load Jira projects."; }
            jiraCheckingStatus = false;
        }
    }

    private async Task OnJiraProjectChanged(string? key)
    {
        if (string.IsNullOrEmpty(key)) return;
        jiraProjectKey = key;
        jiraIssueTypes = new();
        jiraIssueTypeId = "";
        try
        {
            jiraIssueTypes = await Svc.GetJiraIssueTypesAsync(jiraProjectKey);
            if (jiraIssueTypes.Any()) jiraIssueTypeId = jiraIssueTypes[0].Id;
        }
        catch { jiraErrorMessage = "Failed to load issue types."; }
        StateHasChanged();
    }

    private void CloseJiraModal()
    {
        showJiraModal = false;
        jiraNote = null;
        jiraErrorMessage = null;
        jiraSuccessUrl = null;
    }

    private async Task SendToJira()
    {
        if (!jiraConnected)
        {
            jiraErrorMessage = "Not connected to Jira. Please connect first.";
            return;
        }
        if (string.IsNullOrWhiteSpace(jiraProjectKey))
        {
            jiraErrorMessage = "Please select a project.";
            return;
        }
        if (string.IsNullOrWhiteSpace(jiraIssueTypeId))
        {
            jiraErrorMessage = "Please select an issue type.";
            return;
        }

        jiraSending = true;
        jiraErrorMessage = null;
        jiraSuccessUrl = null;

        var issueKey = await Svc.CreateJiraIssueAsync(
            jiraProjectKey,
            jiraIssueTypeId,
            jiraSummary,
            string.IsNullOrWhiteSpace(jiraBody) ? null : jiraBody);

        jiraSending = false;

        if (issueKey != null)
        {
            jiraSuccessUrl = $"https://cglock84.atlassian.net/browse/{issueKey}";
            ShowToast($"Jira issue {issueKey} created ✓");
        }
        else
        {
            jiraErrorMessage = "Failed to create issue. Check proxy logs.";
        }
    }

    private async Task PollForJiraConnection()
    {
        // Poll every 2s for up to 2 minutes waiting for OAuth callback
        for (int i = 0; i < 60; i++)
        {
            await Task.Delay(2000);
            jiraConnected = await Svc.GetJiraStatusAsync();
            if (jiraConnected)
            {
                jiraProjects = await Svc.GetJiraProjectsAsync();
                if (jiraProjects.Any())
                {
                    jiraProjectKey = jiraProjects[0].Key;
                    jiraIssueTypes = await Svc.GetJiraIssueTypesAsync(jiraProjectKey);
                    if (jiraIssueTypes.Any()) jiraIssueTypeId = jiraIssueTypes[0].Id;
                }
                StateHasChanged();
                break;
            }
        }
    }

    // ── Note lifecycle ─────────────────────────────────────────────────

    private async Task ToggleComplete(Note note)
    {
        var metadata = note.Metadata;
        metadata.IsComplete = !(metadata.IsComplete ?? false);
        await Svc.UpdateNoteMetadataAsync(note.Id, metadata);
        await LoadData();
    }

    private async Task SaveNote()
    {
        if (selectedNote == null) return;
        await Svc.UpdateNoteAsync(selectedNote);
        await LoadData();
    }

    private async Task SaveTitle()
    {
        if (selectedNote == null) return;
        try
        {
            Console.WriteLine($"Saving title: {selectedNote.Title}");
            await Svc.UpdateNoteAsync(selectedNote);
            Console.WriteLine("Save succeeded");
            var idx = notes.FindIndex(n => n.Id == selectedNote.Id);
            if (idx >= 0) notes[idx] = selectedNote;
            ApplyFilters();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Save failed: {ex.Message}");
            Console.WriteLine($"Stack: {ex.StackTrace}");
        }
    }

    private async Task UpdateMetadataField(MetaField field, string? value)
    {
        if (selectedNote == null) return;
        switch (field)
        {
            case MetaField.Url:      selectedNote.Metadata.Url = value; break;
            case MetaField.Language: selectedNote.Metadata.Language = value; break;
            case MetaField.Status:   selectedNote.Metadata.Status = value; break;
            case MetaField.DueDate:  selectedNote.Metadata.DueDate = value; break;
        }
        await Svc.UpdateNoteMetadataAsync(selectedNote.Id, selectedNote.Metadata);
        await LoadData();
    }

    private RenderFragment NoteTypeDueDateFragment(Note note) => __builder =>
    {
        if (note.NoteType == NoteType.Assignment && !string.IsNullOrEmpty(note.Metadata.DueDate))
        {
            var due = DateTime.TryParse(note.Metadata.DueDate, out var d) ? d : (DateTime?)null;
            var overdue = due.HasValue && due.Value.Date < DateTime.Today && note.Metadata.IsComplete != true;
            __builder.OpenElement(0, "div");
            __builder.AddAttribute(1, "class", $"task-due{(overdue ? " task-due--overdue" : "")}");
            __builder.AddContent(2, $"📅 {(due.HasValue ? due.Value.ToString("MMM d, yyyy") : note.Metadata.DueDate)}");
            if (overdue)
            {
                __builder.OpenElement(3, "span");
                __builder.AddAttribute(4, "class", "overdue-badge");
                __builder.AddContent(5, "Overdue");
                __builder.CloseElement();
            }
            __builder.CloseElement();
        }
    };

    private async Task ToggleGroupPublic(Group group)
    {
        group.IsPublic = !group.IsPublic;
        await Svc.SetGroupPublicAsync(group.Id, group.IsPublic);
        StateHasChanged();
    }

